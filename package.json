{
  "name": "ishvenom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline snakebite triage and prevention for Africa, powered by Gemma 4.",
  "author": "Kwakye Ishmael Affum (Calyx Ish) <@calyxish>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/calyxish/ishvenom"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './services/*' --filter './apps/*' run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist build .turbo .next node_modules && rm -rf node_modules",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@node-rs/argon2",
      "esbuild"
    ],
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
