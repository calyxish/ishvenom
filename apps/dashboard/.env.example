# IshVenom Dashboard — environment configuration
#
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys.

# ── Backend API ───────────────────────────────────────────────────────
# Points to the Express API (services/api).
# Production: set to your Render URL, e.g. https://ishvenom-api.onrender.com/api/v1
# Local dev: http://localhost:4000/api/v1

NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
