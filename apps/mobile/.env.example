# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.
#
# ── Google AI (Gemma 4 cloud mode) ──────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day — sufficient for demo and development.
#
# When present: Learn + Identify use Gemma 4 26B A4B MoE via the
# Google AI REST API. No model download required.
#
# When absent: both tabs fall back to the on-device llama.rn runtime,
# which requires the Gemma 4 E2B Q3_K_M GGUF (~3 GB) to be present at
# assets/models/ishvenom-gemma-e2b-merged-q3_k_m.gguf.

EXPO_PUBLIC_GOOGLE_AI_KEY=

# ── Backend API ───────────────────────────────────────────────────────
# Points to the Express API (services/api). Local dev default is below.
# Production: set to your Render URL, e.g. https://ishvenom-api.onrender.com

EXPO_PUBLIC_API_URL=http://localhost:4000
