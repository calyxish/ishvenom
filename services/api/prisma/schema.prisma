// IshVenom Prisma schema
// Neon (Postgres 16 + PostGIS 3)
// NOTE: geometry columns use Unsupported — spatial queries must use $queryRaw.
// See .claude/skills/postgis-prisma.md for patterns.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = macOS for local dev (darwin-arm64 / darwin)
  // linux-musl-openssl-3.0.x = node:20-alpine on Render (Alpine 3.20+ ships OpenSSL 3)
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  passwordHash String
  role      UserRole @default(HEALTH_OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
}

enum UserRole {
  ADMIN
  HEALTH_OFFICER
  WHO_REVIEWER
}

model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Species {
  id              String   @id @default(uuid()) @db.Uuid
  scientificName  String   @unique
  commonNames     Json
  venomous        String
  antivenomName   String?
  description     Json?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scientificName])
}

model AntivenomCenter {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  country           String   @db.Char(2)
  location          Unsupported("geometry(Point, 4326)")
  antivenomsStocked Json
  phone             String?
  lastVerified      DateTime?
  createdAt         DateTime @default(now())

  @@index([country])
}

model Encounter {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String
  createdAt     DateTime @default(now())
  speciesGuess  String?
  confidence    Float?
  location      Unsupported("geometry(Point, 4326)")
  district      String?
  country       String   @db.Char(2)
  language      String   @db.Char(2)
  actionTaken   String
  wasBite       Boolean
  metadata      Json?

  @@index([createdAt])
  @@index([country, district])
  @@index([speciesGuess])
}

model SitReport {
  // The hand-written migration created this table with snake_case names —
  // map every field so the Prisma client emits the correct column names.
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now())                 @map("created_at")
  updatedAt        DateTime @updatedAt                      @map("updated_at")
  createdByUserId  String   @db.Uuid                         @map("created_by_user_id")
  scopeCountry     String   @db.Char(2)                      @map("scope_country")
  scopeDistrict    String?                                   @map("scope_district")
  scopeSince       DateTime                                  @map("scope_since")
  scopeUntil       DateTime                                  @map("scope_until")
  status           String   // pending | generating | ready | failed
  model            String
  markdown         String?
  structured       Json?
  error            String?
  promptTokens     Int?                                      @map("prompt_tokens")
  completionTokens Int?                                      @map("completion_tokens")
  latencyMs        Int?                                      @map("latency_ms")

  @@map("sit_reports")
  @@index([createdByUserId])
  @@index([scopeCountry, scopeDistrict])
  @@index([createdAt])
}
