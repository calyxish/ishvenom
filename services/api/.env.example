# IshVenom API — environment configuration
#
# Copy this file to `.env` and fill in real values. Phase 5 added
# REGISTRATION_INVITE_TOKEN and CORS_ORIGIN.

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Postgres (Neon recommended) ──────────────────────────────────────
# DATABASE_URL is used by the runtime; DIRECT_URL is used by `prisma migrate`
# to bypass Neon's connection pooler.
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/ishvenom?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/ishvenom?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────
# MUST be 32+ chars in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="dev-only-change-me-dev-only-change-me"

# MUST be 16+ chars in production. Share this out-of-band with dashboard
# reviewers so they can self-serve registration without opening the gate
# to the public internet.
REGISTRATION_INVITE_TOKEN="dev-only-invite-token-do-not-use-in-prod"

# ── CORS ─────────────────────────────────────────────────────────────
# The exact origin of the Next.js dashboard. Local dev default is 3000.
CORS_ORIGIN="http://localhost:3000"

# ── Optional ─────────────────────────────────────────────────────────
# REDIS_URL is only required if you want distributed rate limiting.
# REDIS_URL="rediss://default:xxx@region.upstash.io:6379"
